[
  {
    "id": "api_v1",
    "path": "/api/v1",
    "methods": ["GET", "POST", "PUT", "DELETE"],
    "upstreams": [
      {"url": "http://localhost:3001", "weight": 5, "healthy": true, "max_fails": 3, "fail_timeout": "30s"},
      {"url": "http://localhost:3002", "weight": 3, "healthy": true, "max_fails": 3, "fail_timeout": "30s"},
      {"url": "http://localhost:3003", "weight": 2, "healthy": true, "max_fails": 3, "fail_timeout": "30s"}
    ],
    "load_balance": "round_robin",
    "retry_count": 3,
    "timeout": "30s",
    "rate_limit": 100,
    "burst": 200,
    "strip_prefix": true,
    "rewrite_path": "/",
    "headers": {
      "X-Service": "api-gateway"
    },
    "auth": {
      "enabled": true,
      "type": "api_key",
      "api_keys": {
        "key1": "key1",
        "key2": "key2"
      }
    },
    "circuit_breaker": {
      "enabled": true,
      "failure_threshold": 5,
      "timeout": "60s",
      "half_open_max": 3
    }
  },
  {
    "id": "static",
    "path": "/static",
    "methods": ["GET"],
    "upstreams": [
      {"url": "http://localhost:8080", "weight": 1, "healthy": true, "max_fails": 3, "fail_timeout": "30s"}
    ],
    "load_balance": "random",
    "retry_count": 2,
    "timeout": "10s",
    "rate_limit": 500,
    "burst": 1000,
    "strip_prefix": false
  },
  {
    "id": "websocket",
    "path": "/ws",
    "methods": ["GET"],
    "upstreams": [
      {"url": "http://localhost:9001", "weight": 1, "healthy": true, "max_fails": 3, "fail_timeout": "30s"}
    ],
    "load_balance": "least_conn",
    "retry_count": 1,
    "timeout": "0s",
    "rate_limit": 0
  }
]
